# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/

# Database name
DB_NAME=music_bot

# Admin Telegram user IDs (comma separated)
ADMIN_IDS=123456789,987654321

# Channel ID for new release notifications (username or numeric ID)
# e.g. @my_music_channel or -1001234567890
CHANNEL_ID=

# Optional: build marker
BUILD_VERSION=v0.9.1

# ==================== Voice Chat (VC) streaming ====================
# API_ID / API_HASH from https://my.telegram.org/apps
API_ID=
API_HASH=

# Pyrogram StringSession of a *user* account ("assistant") that joins the
# group voice chat and streams audio. Generate locally with:
#     python generate_session.py
SESSION=

# Streaming limits
DURATION_LIMIT=60
QUEUE_LIMIT=20
VIDEO_PLAY=True

# Optional: path to a Netscape cookies.txt (helps YouTube avoid bot checks)
COOKIES_FILE=

# Optional: Spotify Web API credentials (best Spotify support)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
